# Environment variables required by the backend (set these in Vercel → Project
# Settings → Environment Variables). Do NOT commit a real .env file.

# Anthropic API key for the chatbot (/api/ask)
ANTHROPIC_API_KEY=

# Firebase service account, used to verify user sign-in and read/write credits.
# Get this from: Firebase Console → Project Settings → Service Accounts →
# "Generate new private key". Paste the ENTIRE contents of the downloaded
# JSON file as the value of this single variable (as one line/string).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional — local dev only, Vercel sets this automatically in production.
PORT=3000
