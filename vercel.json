{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/app/(.+)",
      "dest": "/web_build/$1"
    },
    {
      "src": "/app",
      "dest": "/web_build/index.html"
    },
    {
      "src": "/app/",
      "dest": "/web_build/index.html"
    }
  ]
}
